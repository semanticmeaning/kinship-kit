            "sibling-of",
            "other"
          ]
        },
        {
          "name": "person_b_id",
          "type": "ref",
          "ref": "persons",
          "required": true
        },
        {
          "name": "nature",
          "type": "enum",
          "enum": [
            "",
            "biological",
            "legal",
            "household",
            "unknown"
          ]
        },
        {
          "name": "claim_ids",
          "type": "refs",
          "ref": "claims"
        },
        {
          "name": "supporting_artifact_ids",
          "type": "refs",
          "ref": "artifacts"
        },
        {
          "name": "contradicting_artifact_ids",
          "type": "refs",
          "ref": "artifacts"
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "enum": [
            "hypothesis",
            "single-source",
            "corroborated",
            "strongly-corroborated",
            "contradicted",
            "unresolved",
            "rejected",
            "superseded"
          ]
        },
        {
          "name": "rationale"
        }
      ]
